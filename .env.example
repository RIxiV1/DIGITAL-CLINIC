# ---------------------------------------------------------------------------
# ForMen Digital Clinic — environment variables
#
# Copy this file to `.env.local` (gitignored) for local development, and set
# the same keys in your host's dashboard for production:
#   Vercel → Project → Settings → Environment Variables → add → Redeploy.
#   (Env changes only take effect on a NEW deployment, not the running one.)
#
# NONE of these are required to run the app. The privacy-first core — the
# client-side parser (PDF text layer + Tesseract OCR, all on-device) — works
# with zero config. These only enable the OPTIONAL Gemini vision fallback
# (`/api/parse-image`) for reports the local parser can't read: photos, and
# scanned or multi-column tables where OCR scrambles the layout.
# ---------------------------------------------------------------------------

# Google Gemini API key — enables the "Try AI parser" fallback button.
# Get one (free tier) at https://aistudio.google.com/apikey
#
# SECURITY: this is a SERVER-SIDE secret. It is read only by the serverless
# function (api/parse-image.ts) and never reaches the browser. Never commit a
# real key, and never prefix it with VITE_ (that would bundle it into the
# client and leak it). When unset, the AI button reports "GEMINI_API_KEY not
# configured on the server" and the app falls back to manual entry.
#
# PRIVACY NOTE: this is the one path where an image leaves the device (sent to
# Google, which may retain it). It is opt-in — the user taps "Try AI parser" —
# so it stays consistent with the on-device privacy promise. Keep it opt-in.
GEMINI_API_KEY=

# Origins allowed to call /api/parse-image. Comma-separated. Each entry is
# either a literal origin or a regex prefixed with `re:`. Example:
#   ALLOWED_ORIGINS=https://digital-clinic-formen.vercel.app,re:^https://.*\.vercel\.app$
# When unset/empty, the function uses built-in defaults (localhost dev ports),
# and the deployment's own same-origin requests are always allowed.
ALLOWED_ORIGINS=

# Set to "1" to allow requests with no Origin header (e.g. curl, server-to-
# server testing). Leave unset in production — browsers always send Origin.
ALLOW_NO_ORIGIN=
