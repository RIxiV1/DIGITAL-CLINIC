{
  "name": "formen-digital-clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor:ocr": "node scripts/vendor-ocr-assets.mjs",
    "predev": "npm run vendor:ocr",
    "prebuild": "npm run vendor:ocr"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@google/generative-ai": "^0.21.0",
    "framer-motion": "^11.11.17",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.1.13",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
